{
    "name": "togul/php-sdk",
    "description": "PHP SDK for Togul Feature Flag Service",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.15.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "open-feature/sdk": "^2.3"
    },
    "suggest": {
        "open-feature/sdk": "Use Togul as an OpenFeature provider via Togul\\OpenFeature\\TogulProvider (^2.3)"
    },
    "autoload": {
        "psr-4": {
            "Togul\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Togul\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests"
    },
    "minimum-stability": "stable"
}
